{
  "name": "angular-security-guidelines",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start-server": "ts-node --project tsconfig.server.json ./server/server.ts --secure",
    "server": "nodemon  -w ./server --ext \".ts\" --exec \"npm run start-server\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "body-parser": "^2.4.0",
    "command-line-args": "^6.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "http-server": "^14.1.1",
    "nodemon": "^3.1.14",
    "rxjs": "~7.8.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^26.6.6",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
